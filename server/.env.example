# SocietyOS Environment Configuration
PORT=5000
NODE_ENV=development

# Leave empty to use automatic embedded high-performance MongoDB, or provide MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/societyos?retryWrites=true&w=majority
MONGO_URI=

JWT_SECRET=societyos_super_secure_production_jwt_key_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads

# Stripe test-mode credentials. Keep secret keys server-side only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
